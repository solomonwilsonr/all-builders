{
  "manifest_version": 3,
  "name": "SafeShelf",
  "version": "2.12.1",
  "description": "Is it safe? Is it real? Checks the product page you are on.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "http://localhost/*",
    "https://securetoken.googleapis.com/*",
    "https://*.run.app/*",
    "https://firestore.googleapis.com/*"
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "SafeShelf",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "externally_connectable": {
    "matches": [
      "https://shelf2026-3656b.web.app/*",
      "https://shelf2026-3656b.firebaseapp.com/*",
      "https://safeshelf.online/*",
      "https://www.safeshelf.online/*",
      "http://localhost:8095/*"
    ]
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "http://localhost:8090/*",
        "http://localhost:8091/*",
        "https://safeshelf-shops.web.app/*",
        "https://shops.safeshelf.online/*",
        "https://safeshelf-shops.firebaseapp.com/*",
        "https://www.amazon.in/*",
        "https://www.amazon.com/*",
        "https://www.amazon.co.jp/*",
        "https://www.amazon.com.au/*",
        "https://www.amazon.sg/*",
        "https://www.flipkart.com/*"
      ],
      "js": [
        "panels.js",
        "investigate.js",
        "aftercare.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+S"
      },
      "description": "Open the SafeShelf menu"
    }
  },
  "web_accessible_resources": [
    {
      "resources": [
        "assets/flags/*.png"
      ],
      "matches": [
        "http://localhost:8090/*",
        "https://www.amazon.in/*",
        "https://www.amazon.com/*",
        "https://www.amazon.co.jp/*",
        "https://www.amazon.com.au/*",
        "https://www.amazon.sg/*",
        "https://www.flipkart.com/*"
      ]
    }
  ]
}
