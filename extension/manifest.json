{
  "manifest_version": 3,
  "name": "SafeShelf",
  "version": "2.4.0",
  "description": "Is it safe? Is it real? Checks the product page you are on.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "http://localhost/*",
    "https://*.run.app/*"
  ],
  "action": {
    "default_title": "SafeShelf",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "http://localhost:8090/*",
        "https://www.amazon.in/*",
        "https://www.amazon.com/*",
        "https://www.flipkart.com/*"
      ],
      "js": [
        "panels.js",
        "investigate.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+S"
      },
      "description": "Open the SafeShelf menu"
    }
  }
}
