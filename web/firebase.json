{
  "hosting": {
    "site": "shelf2026-3656b",
    "public": ".",
    "ignore": [
      "firebase.json",
      "firebase-debug*.log",
      "README.md",
      ".env.example",
      "record_samples.py",
      "build_support_kb.py",
      "build_api_docs.py",
      "**/.*",
      "**/__pycache__/**",
      "firestore.rules",
      "downloads/**",
      "api-integration/**",
      "landing-terminal/**"
    ],
    "redirects": [
      { "source": "/api-integration{,/**}", "destination": "/site/api.html", "type": 301 },
      { "source": "/landing-terminal{,/**}", "destination": "/site/index.html", "type": 301 }
    ],
    "headers": [
      {
        "source": "samples/*.json",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "max-age=300"
          }
        ]
      },
      {
        "source": "data/*.json",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "max-age=300"
          }
        ]
      }
    ]
  },
  "firestore": {
    "rules": "firestore.rules"
  }
}
